# Local Docker example only.
# Use `infra/.env.publish.example` for a public deployment.
POSTGRES_USER=arenzyra
POSTGRES_PASSWORD=
POSTGRES_DB=pubg_prod
DATABASE_URL=
STUDIO_DATABASE_URL=
STUDIO_DATABASE_SSL=
STUDIO_DATABASE_POOL_SIZE=

JWT_SECRET=replace_with_a_long_random_value
IDP_CREDENTIAL_ENCRYPTION_KEY=replace_with_a_separate_long_random_value
PUBLIC_ORGANIZATION_APPLICATIONS_ENABLED=false
SUPERADMIN_MFA_REQUIRED=true
SUPERADMIN_MFA_ENCRYPTION_KEY=replace_with_a_distinct_32_byte_random_value
SUPERADMIN_MFA_RECOVERY_PEPPER=replace_with_another_distinct_32_byte_random_value
COLLECTOR_SECRET=replace_with_a_long_random_value
PCOB_SECRET=replace_with_a_long_random_value

# Redis uses noeviction so security rate-limit state is never silently evicted.
REDIS_MAXMEMORY=768mb
REDIS_READY_MAX_MEMORY_RATIO=0.85
DISTRIBUTED_RATE_LIMIT_REQUIRED=true
EVENT_BUS_MAX_PAYLOAD_BYTES=524288
EVENT_BUS_STREAM_MAXLEN=10000

SUPERADMIN_EMAIL=superadmin@arenzyra.com
SUPERADMIN_PASSWORD=change_me_local
ARENZYRA_BILLING_REVIEW_EMAIL=
PAYMENT_PROOF_RETENTION_DAYS=90
BILLING_RESERVATION_LOCK_SECONDS=120
BILLING_RESERVATION_RETENTION_HOURS=24
BILLING_RESERVATION_CLEANUP_BATCH=50
BILLING_REVIEW_CLAIM_LEASE_MINUTES=30
BILLING_OUTBOX_CLAIM_SECONDS=300
BILLING_OUTBOX_WORKER_ENABLED=true
BILLING_OUTBOX_WORKER_INTERVAL_SECONDS=60
BILLING_OUTBOX_WORKER_BATCH=10
BILLING_OUTBOX_SHUTDOWN_MS=15000
BILLING_SMTP_CONNECTION_TIMEOUT_MS=5000
BILLING_SMTP_GREETING_TIMEOUT_MS=5000
BILLING_SMTP_SOCKET_TIMEOUT_MS=10000
OP_EMAIL=operator@arenzyra.com
OP_PASSWORD=change_me_local

PLATFORM_ADMIN_EMAIL=platform-admin@arenzyra.com
PLATFORM_ADMIN_PASSWORD=change_me

WEB_APP_ORIGIN=http://localhost:3005
FRONTEND_ORIGIN=http://localhost:3005
NEXT_PUBLIC_API_URL=http://localhost:3000
INTERNAL_API_URL=http://api:3000
# Optional server-only signed launcher release metadata. Empty is fail-closed.
ARENZYRA_LAUNCHER_RELEASE_JSON=
OBSERVER_BASE_URL=http://host.docker.internal:10086
LIVE_SYNC_RESULTS_WRITE_ENABLED=0
API_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000

ARENZYRA_API_SERVICE_TOKEN_SHA256=
STUDIO_QA_SERVICE_TOKEN_SHA256=
ARENZYRA_API_SERVICE_ORGANIZATION_ID=
ARENZYRA_API_SERVICE_USER_ID=
ARENZYRA_API_SERVICE_USER_EMAIL=discord-bot@arenzyra.local

MEDIA_AI_URL=
STUDIO_MEDIA_AI_URL=
STUDIO_MEDIA_AI_TIMEOUT_MS=60000
STUDIO_REMOVE_BG_API_KEY=
STUDIO_REMOVE_BG_API_URL=
STUDIO_REMOVE_BG_SIZE=auto
STUDIO_REMOVE_BG_TYPE=auto
STUDIO_REQUIRE_EXTERNAL_IMAGE_PROVIDER=false
STUDIO_ALLOW_LOCAL_DEV_WORKSPACE=false

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3005/organizer/youtube/callback
YOUTUBE_STATE_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY_ID=
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_TOKEN_ENCRYPTION_PREVIOUS_KEYS={}
YOUTUBE_TOKEN_ENCRYPTION_LEGACY_V1_KEY=
