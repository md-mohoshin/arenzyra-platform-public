# Public deployment example.
# Copy this file to `infra/.env.publish` on the server and replace every placeholder.

ACME_EMAIL=ops@arenzyra.com
PUBLIC_WEB_HOST=arenzyra.com
PUBLIC_API_HOST=api.arenzyra.com

POSTGRES_USER=arenzyra
POSTGRES_PASSWORD=
POSTGRES_DB=pubg_prod
# All seven URLs must use postgres:5432, POSTGRES_DB, and the only supported
# schema contract: schema=public plus options=-c%20search_path%3Dpublic. Only
# their roles differ.
# The guarded deploy backs up this one supported database before migration.
DATABASE_URL=
MIGRATION_DATABASE_URL=
# Required: a dedicated Studio role with access only to Studio-owned tables;
# do not reuse POSTGRES_USER or the API migration/owner role.
STUDIO_DATABASE_URL=
STUDIO_MIGRATION_DATABASE_URL=
# Required: one shared read-only role for maintenance scans and two separate
# task-specific apply roles. Never place either apply URL in a dry-run service.
MAINTENANCE_READ_DATABASE_URL=
IDP_MAINTENANCE_DATABASE_URL=
YOUTUBE_MAINTENANCE_DATABASE_URL=
STUDIO_DATABASE_SSL=
STUDIO_DATABASE_CA=
STUDIO_DATABASE_POOL_SIZE=

JWT_SECRET=replace_with_a_long_random_value
IDP_CREDENTIAL_ENCRYPTION_KEY=replace_with_a_separate_long_random_value
SUPERADMIN_MFA_REQUIRED=true
SUPERADMIN_MFA_ENCRYPTION_KEY=replace_with_a_distinct_32_byte_random_value
SUPERADMIN_MFA_RECOVERY_PEPPER=replace_with_another_distinct_32_byte_random_value
HEALTHCHECK_TOKEN=replace_with_a_32_byte_random_value
STUDIO_MEDIA_SIGNING_SECRET=replace_with_a_32_byte_random_value
COLLECTOR_SECRET=replace_with_a_long_random_value
PCOB_SECRET=replace_with_a_long_random_value

# Redis capacity is bounded with noeviction. Readiness fails at this ratio so
# operators can add capacity before writes (including security limits) fail.
REDIS_MAXMEMORY=768mb
REDIS_READY_MAX_MEMORY_RATIO=0.85
DISTRIBUTED_RATE_LIMIT_REQUIRED=true
EVENT_BUS_MAX_PAYLOAD_BYTES=524288
EVENT_BUS_STREAM_MAXLEN=10000

# Bounded PCOB raw-event hot retention, hard admission, and processing memory.
# These defaults match the API. Increase them only with database/disk monitoring.
PCOB_RAW_RETENTION_ACKED_EVENTS=10000
PCOB_RAW_RETENTION_STREAM_BYTES=268435456
PCOB_RAW_RETENTION_MATCH_BYTES=2147483648
PCOB_RAW_MAX_STREAMS_PER_MATCH=16
PCOB_RAW_MAX_SEQUENCE_LOOKAHEAD=10000
PCOB_RAW_HARD_MAX_EVENTS_PER_STREAM=20000
PCOB_RAW_HARD_MAX_STREAM_BYTES=536870912
PCOB_RAW_HARD_MAX_MATCH_BYTES=4294967296
PCOB_RAW_PROCESSING_BATCH_SIZE=500
PCOB_RAW_PROCESSING_BATCH_BYTES=67108864
PCOB_RAW_PROCESSING_LEASE_MS=60000
PCOB_RAW_PROVIDER_TERMINAL_QUIET_MS=15000
PCOB_MAX_BODY_BYTES=16777216
PCOB_RAW_MAX_ENCODED_EVENT_BYTES=6291456
PCOB_RAW_MAX_ENCODED_BATCH_BYTES=7340032
PCOB_RAW_MAX_ORIGINAL_BATCH_BYTES=33554432

# Production accounts must be provisioned through an audited administrative
# workflow. AUTH_DEV_BOOTSTRAP_ENABLED and its plaintext credentials are
# development-only and must not be present in this production environment.

WEB_APP_ORIGIN=https://arenzyra.com
FRONTEND_ORIGIN=https://arenzyra.com
NEXT_PUBLIC_API_URL=https://api.arenzyra.com
INTERNAL_API_URL=http://api:3000
# Optional server-only signed launcher release metadata. Leave empty until a
# reviewed immutable release is ready; see apps/arenzyra-web/docs/launcher-release-downloads.md.
ARENZYRA_LAUNCHER_RELEASE_JSON=
API_BASE_URL=https://api.arenzyra.com
API_PUBLIC_URL=https://api.arenzyra.com
ASSET_BASE_URL=https://api.arenzyra.com
TRUST_PROXY=true
ARENZYRA_DOCKER_SUBNET=172.30.50.0/24
ARENZYRA_PROXY_IP=172.30.50.2
TRUSTED_PROXY_IPS=172.30.50.2

# Email notifications. SMTP values are required for application/support emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Arenzyra <support@arenzyra.com>
ARENZYRA_SUPPORT_EMAIL=contact@arenzyra.com
APPLICATION_NOTIFY_EMAIL=
APPLICATION_NOTIFICATION_EMAIL=
ARENZYRA_BILLING_REVIEW_EMAIL=billing@arenzyra.com

# Operational defaults only; confirm the required legal/tax retention policy.
PAYMENT_PROOF_RETENTION_DAYS=90
BILLING_RESERVATION_LOCK_SECONDS=120
BILLING_RESERVATION_RETENTION_HOURS=24
BILLING_RESERVATION_CLEANUP_BATCH=50
BILLING_REVIEW_CLAIM_LEASE_MINUTES=30
BILLING_OUTBOX_CLAIM_SECONDS=300
BILLING_OUTBOX_WORKER_INTERVAL_SECONDS=60
BILLING_OUTBOX_WORKER_BATCH=10
BILLING_OUTBOX_SHUTDOWN_MS=15000
BILLING_SMTP_CONNECTION_TIMEOUT_MS=5000
BILLING_SMTP_GREETING_TIMEOUT_MS=5000
BILLING_SMTP_SOCKET_TIMEOUT_MS=10000

ARENZYRA_API_SERVICE_TOKEN_SHA256=
# Raw counterpart used only by the Discord bot service. Generate one random
# token and store its SHA-256 digest above for API verification.
ARENZYRA_API_SERVICE_TOKEN=
STUDIO_QA_SERVICE_TOKEN_SHA256=
ARENZYRA_API_SERVICE_ORGANIZATION_ID=
ARENZYRA_API_SERVICE_USER_ID=
ARENZYRA_API_SERVICE_USER_EMAIL=discord-bot@arenzyra.local

DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=https://arenzyra.com/organizer/discord/callback
DISCORD_INSTALL_STATE_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_MESSAGE_CONTENT_INTENT=true
DISCORD_GUILD_MEMBERS_INTENT=false
DISCORD_REGISTER_GLOBAL_COMMANDS=true
ARENZYRA_DISCORD_BOT_INSTANCE=production
ARENZYRA_API_REQUEST_TIMEOUT_MS=10000
ARENZYRA_API_MAX_IDEMPOTENT_RETRIES=2
TELEGRAM_BOT_TOKEN=
TELEGRAM_IMPORT_POLLING=false

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://arenzyra.com/organizer/youtube/callback
YOUTUBE_STATE_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY_ID=replace_with_unique_youtube_key_id
YOUTUBE_TOKEN_ENCRYPTION_KEY=replace_with_a_distinct_32_byte_minimum_secret
YOUTUBE_TOKEN_ENCRYPTION_PREVIOUS_KEYS={}
YOUTUBE_TOKEN_ENCRYPTION_LEGACY_V1_KEY=

# Optional Studio image providers. MEDIA_AI_URL enables no-key local AI
# background removal; remove.bg is still optional for external production quality.
STUDIO_MEDIA_AI_URL=
STUDIO_MEDIA_AI_TIMEOUT_MS=60000
STUDIO_REMOVE_BG_API_KEY=
STUDIO_REMOVE_BG_API_URL=
STUDIO_REMOVE_BG_SIZE=auto
STUDIO_REMOVE_BG_TYPE=auto
STUDIO_REQUIRE_EXTERNAL_IMAGE_PROVIDER=false
STUDIO_ALLOW_LOCAL_DEV_WORKSPACE=false
ARENZYRA_WEB_ALLOW_OBSERVER_DIRECT=0
ARENZYRA_WEB_OBSERVER_LOCAL_PROBE=0
# The supported public deployment intentionally does not pass
# ARENZYRA_OBSERVER_DIRECT_SECRET. Direct observer routes stay disabled; use
# the authenticated desktop bridge instead.

# Optional integrations. Uncomment and set them only if you use these services.
# OBSERVER_BASE_URL=http://host.docker.internal:10086
# PCOB_BASE_URL=http://host.docker.internal:10086
# SHADOW_API_BASE=http://host.docker.internal:10086
# MATCH_STATE_BASE=http://host.docker.internal:4000
# LIVE_SYNC_RESULTS_WRITE_ENABLED=1
MEDIA_AI_URL=http://media-ai:5055
# Optional comma-separated HTTPS origins for reviewed external image storage.
# API-origin and Discord CDN images are allowed without this setting.
ARENZYRA_MEDIA_ALLOWED_ORIGINS=
# Production media-ai refuses work until u2net.onnx and
# isnet-general-use.onnx match /models/manifest.sha256. Populate the named
# volume with `bash scripts/warm-media-ai-model-cache.sh` before deployment.

# Every full deployment takes and verifies a fresh encrypted recovery point
# immediately before migrations. Keep the age private identity off this host.
ARENZYRA_BACKUP_AGE_RECIPIENT=
ARENZYRA_BACKUP_ROOT=/opt/arenzyra-backups
# Mandatory off-host destination. Pre-migration deploy backups are uploaded
# immutably and checksum-verified before any migration is allowed to start.
ARENZYRA_BACKUP_RCLONE_REMOTE=encrypted-offsite:arenzyra/production
ARENZYRA_BACKUP_HELPER_IMAGE=postgres:16.14-alpine@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777
ARENZYRA_DEPLOY_COMPOSE_PROJECT=infra
