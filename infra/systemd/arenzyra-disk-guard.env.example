# Optional overrides for /etc/arenzyra-disk-guard.env.
ARENZYRA_DISK_PATH=/
ARENZYRA_DISK_WARN_PERCENT=75
ARENZYRA_DISK_CLEAN_PERCENT=80
ARENZYRA_DISK_CRITICAL_PERCENT=90
ARENZYRA_DOCKER_BUILD_CACHE_UNTIL=168h
ARENZYRA_DOCKER_IMAGE_UNTIL=336h
ARENZYRA_DOCKER_CONTAINER_UNTIL=168h
ARENZYRA_DEPLOY_BACKUP_RETENTION_DAYS=45
ARENZYRA_DOCKER_LOG_MAX_MB=200
ARENZYRA_JOURNAL_VACUUM_SIZE=1G
ARENZYRA_DISK_GUARD_LOG_FILE=/var/log/arenzyra-disk-guard.log
# Leave backup deletion disabled for the timer. Review source/deploy backups
# separately; never enable this merely to clear a failed deploy preflight.
ARENZYRA_DISK_GUARD_ALLOW_DEPLOY_BACKUP_PRUNE=0

# Optional Discord/webhook URL for disk warnings.
# ARENZYRA_DISK_ALERT_WEBHOOK_URL=
