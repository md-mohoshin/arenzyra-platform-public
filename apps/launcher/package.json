{
  "name": "arenzyra-launcher",
  "version": "1.0.0",
  "description": "System control launcher for the Arenzyra service stack",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "sync:branding": "node ../../scripts/sync-brand-icons.cjs",
    "dist": "npm run sync:branding && electron-builder -w",
    "test": "node --test process-ownership.test.cjs ../../infra/health-artifact-policy.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true,
  "type": "commonjs",
  "devDependencies": {
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.arenzyra.launcher",
    "productName": "Arenzyra Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "process-ownership.cjs",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../../infra/health-readonly.ps1",
        "to": "health-readonly.ps1"
      },
      {
        "from": "../../infra/health-artifact-policy.cjs",
        "to": "health-artifact-policy.cjs"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    }
  }
}
