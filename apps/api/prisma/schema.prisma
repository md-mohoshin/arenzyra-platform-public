  createdAt       DateTime         @default(now())
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  challenge       YoutubeChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, authorChannelId])
  @@index([organizationId])
  @@index([challengeId])
  @@index([liveSessionId])
  @@index([authorChannelId])
}

model YoutubeChatCommand {
  id                  String           @id @default(uuid())
  organizationId      String
  channelId           String?
  command             String
  responseTemplate    String
  enabled             Boolean          @default(true)
  cooldownSeconds     Int              @default(30)
  userCooldownSeconds Int              @default(10)
  usageCount          Int              @default(0)
  lastUsedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel             YoutubeChannel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  logs                YoutubeChatLog[]

  @@unique([organizationId, channelId, command])
  @@index([organizationId])
  @@index([channelId])
  @@index([enabled])
  @@index([deletedAt])
}

model YoutubeChatTimer {
  id              String                  @id @default(uuid())
  organizationId  String
  channelId       String?
  liveSessionId   String?
  name            String
  message         String
  enabled         Boolean                 @default(true)
  intervalMinutes Int                     @default(15)
  minChatLines    Int                     @default(5)
  postedCount     Int                     @default(0)
  lastFiredAt     DateTime?
  nextFireAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel         YoutubeChannel?         @relation(fields: [channelId], references: [id], onDelete: SetNull)
  liveSession     YoutubeLiveChatSession? @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  logs            YoutubeChatLog[]

  @@index([organizationId])
  @@index([channelId])
  @@index([liveSessionId])
  @@index([enabled])
  @@index([nextFireAt])
  @@index([deletedAt])
}

model YoutubeChatLog {
  id                String                  @id @default(uuid())
  organizationId    String
  channelId         String?
  liveSessionId     String?
  liveMessageId     String?
  commandId         String?
  timerId           String?
  action            String
  status            String
  command           String?
  authorChannelId   String?
  authorName        String?
  requestText       String?
  responseText      String?
  youtubeResponseId String?
  error             String?
  createdAt         DateTime                @default(now())
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel           YoutubeChannel?         @relation(fields: [channelId], references: [id], onDelete: SetNull)
  liveSession       YoutubeLiveChatSession? @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  liveMessage       YoutubeLiveChatMessage? @relation(fields: [liveMessageId], references: [id], onDelete: SetNull)
  chatCommand       YoutubeChatCommand?     @relation(fields: [commandId], references: [id], onDelete: SetNull)
  chatTimer         YoutubeChatTimer?       @relation(fields: [timerId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([channelId])
  @@index([liveSessionId])
  @@index([commandId])
  @@index([timerId])
  @@index([action])
  @@index([status])
}

model YoutubeGiveawayWinner {
  id             String               @id @default(uuid())
  organizationId String
  giveawayId     String
  entryId        String
  position       Int
  pickedById     String?
  pickedAt       DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  giveaway       YoutubeGiveaway      @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  entry          YoutubeGiveawayEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  pickedBy       User?                @relation("YoutubeGiveawayWinnerPickedBy", fields: [pickedById], references: [id], onDelete: SetNull)

  @@unique([giveawayId, entryId])
  @@unique([giveawayId, position])
  @@index([organizationId])
  @@index([giveawayId])
}

model YoutubeAuditLog {
  id             String          @id @default(uuid())
  organizationId String
  channelId      String?
  actorUserId    String?
  action         String
  targetType     String
  targetId       String?
  before         Json?
  after          Json?
  createdAt      DateTime        @default(now())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        YoutubeChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([channelId])
  @@index([action])
  @@index([targetType, targetId])
}

enum YoutubeChannelStatus {
  CONNECTED
  REAUTH_REQUIRED
  DISABLED
}

enum YoutubeCommentReviewStatus {
  NEW
  REVIEWED
  NEEDS_REPLY
  REPLIED
  IGNORED
  HELD
}

enum YoutubeReplyStatus {
  DRAFT
  PENDING_APPROVAL
  POSTED
  FAILED
  CANCELLED
}

enum YoutubeAutomationMatchMode {
  KEYWORD
  CONTAINS
  REGEX
}

enum YoutubeGiveawayMode {
  KEYWORD
  PREDICTION
}

enum YoutubeGiveawayStatus {
  DRAFT
  OPEN
  CLOSED
  DRAWN
  CANCELLED
}

enum YoutubeLiveChatSessionStatus {
  READY
  RUNNING
  PAUSED
  ENDED
  ERROR
}
