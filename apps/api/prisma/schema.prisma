generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminAdjustment {
  id           String     @id @default(uuid())
  tournamentId String
  matchId      String?
  teamId       String
  pointsDelta  Int
  reason       String?
  createdById  String?
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?
  team         Team       @relation(fields: [teamId], references: [id])
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match        Match?     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdBy    User?      @relation("AdminAdjustmentCreatedBy", fields: [createdById], references: [id])

  @@index([tournamentId])
  @@index([teamId])
  @@index([matchId])
  @@index([deletedAt])
}

model AdminOrganizationLink {
  id             String       @id @default(uuid())
  adminId        String
  organizationId String
  createdAt      DateTime     @default(now())
  admin          User         @relation(fields: [adminId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([adminId, organizationId])
  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  action         AuditAction
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  source         String
  reason         String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([organizationId])
}

model Ban {
  id             String    @id @default(uuid())
  targetUserId   String?
  targetPlayerId String?
  reason         String
  expiresAt      DateTime?
  createdBy      String?
  createdAt      DateTime  @default(now())
  createdByUser  User?     @relation("Ban_createdByToUser", fields: [createdBy], references: [id])
  player         Player?   @relation(fields: [targetPlayerId], references: [id])
  targetUser     User?     @relation("Ban_targetUserIdToUser", fields: [targetUserId], references: [id])

  @@index([targetPlayerId])
  @@index([targetUserId])
}

model FeedLock {
  id        String   @id @default("singleton")
  matchId   String
  clientId  String
  lockedAt  DateTime @default(now())
  expiresAt DateTime
}

model Group {
  id                      String                   @id @default(uuid())
  name                    String
  stageId                 String
  organizationId          String
  liveState               LiveState                @default(UPCOMING)
  liveAt                  DateTime?
  endedAt                 DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  maxTeams                Int?                     @default(25)
  qualificationRule       String?
  stage                   Stage                    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  organization            Organization             @relation(fields: [organizationId], references: [id])
  groupTeams              GroupTeam[]
  matches                 Match[]
  tournamentRegistrations TournamentRegistration[]
  tournamentInvites       TournamentInvite[]

  @@index([deletedAt])
  @@index([stageId])
  @@index([organizationId])
}

model GroupTeam {
  id               String         @id @default(uuid())
  groupId          String
  tournamentTeamId String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  group            Group          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  tournamentTeam   TournamentTeam @relation(fields: [tournamentTeamId], references: [id], onDelete: Restrict)

  @@unique([groupId, tournamentTeamId])
  @@index([deletedAt])
  @@index([groupId])
  @@index([tournamentTeamId])
}

model Match {
  id                      String                @id @default(uuid())
  name                    String?
  tournamentId            String?
  organizationId          String
  ownerUserId             String?
  stageId                 String?
  groupId                 String?
  sessionId               String?
  gameId                  String?
  rulesetId               String?
  status                  MatchStatus           @default(DRAFT)
  liveState               LiveState             @default(UPCOMING)
  liveAt                  DateTime?
  endedAt                 DateTime?
  endedReason             String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  deletedAt               DateTime?
  lobbyCode               String?
  matchNumber             Int?
  slotCount               Int                   @default(25)
  scheduledAt             DateTime?
  startedAt               DateTime?
  recallEnabled           Boolean               @default(false)
  map                     MatchMap?
  dataMode                DataMode              @default(MANUAL)
  dataSource              MatchDataSource       @default(MANUAL)
  telemetrySource         TelemetrySource       @default(AUTO)
  telemetrySourceLockedAt DateTime?
  pcobSessionId           String?
  pcobStatus              PcobStatus            @default(PENDING)
  pcobMode                Boolean               @default(false)
  pcobKillSyncEnabled     Boolean               @default(false)
  pcobLastSeenAt          DateTime?             @db.Timestamp(6)
  pcobBoundAt             DateTime?
  adapterKey              String?
  notes                   String?
  game                    Game?                 @relation(fields: [gameId], references: [id])
  ruleset                 Ruleset?              @relation(fields: [rulesetId], references: [id])
  group                   Group?                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  stage                   Stage?                @relation(fields: [stageId], references: [id], onDelete: Cascade)
  tournament              Tournament?           @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  session                 Session?              @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  controlState            MatchControlState?
  events                  MatchEvent[]
  matchSlots              MatchSlot[]
  matchTeams              MatchTeam[]
  pcobAppliedEvents       PcobAppliedEvent[]
  pcobUnmatchedKills      PcobUnmatchedKill[]
  pcobUnmatchedPlayers    PcobUnmatchedPlayer[]
  matchRounds             MatchRound[]
  liveTeams               LiveTeam[]
  livePlayers             LivePlayer[]
  teamMappings            TeamMapping[]
  playerMappings          PlayerMapping[]
  matchPlayers            MatchPlayer[]
  telemetry               MatchTelemetry?
  telemetryEventLogs      TelemetryEventLog[]
  stateSnapshot           MatchStateSnapshot?
  pcobRawEvents           PcobRawEvent[]
  pcobState               PcobState?
  adminAdjustments        AdminAdjustment[]
  matchScore              MatchScore?
  slotResults             MatchSlotResult[]
  topFragger              MatchTopFragger?
  organization            Organization          @relation(fields: [organizationId], references: [id])
  widgetInstances         WidgetInstance[]
  standings               MatchStanding[]

  @@index([deletedAt])
  @@index([groupId])
  @@index([stageId])
  @@index([tournamentId])
  @@index([organizationId])
  @@index([gameId])
  @@index([adapterKey])
  @@index([rulesetId])
  @@index([sessionId])
}

model MatchControlState {
  /// Run `npx prisma migrate dev --name f17_control_state` after updating this model.
  id                 String                 @id @default(uuid())
  matchId            String                 @unique
  organizationId     String
  state              ControlState           @default(READY)
  authorityMode      TelemetryAuthorityMode @default(AUTO)
  version            Int                    @default(0)
  reason             String?
  metaJson           Json?
  updatedByUserId    String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  resultsManualLock  Boolean                @default(false)
  resultsForceUnlock Boolean                @default(false)
  match              Match                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  organization       Organization           @relation(fields: [organizationId], references: [id])
  updatedByUser      User?                  @relation("MatchControlStateUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([organizationId])
}

model MatchEvent {
  eventId        String         @id @default(uuid())
  matchId        String
  organizationId String
  seq            Int
  type           MatchEventType
  teamId         String?
  playerId       String?
  timestamp      DateTime
  payload        Json
  rawPayload     Json
  createdAt      DateTime       @default(now())
  match          Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id])

  @@unique([matchId, seq])
  @@index([matchId])
  @@index([playerId])
  @@index([teamId])
  @@index([organizationId])
}

model MatchSlot {
  id             String      @id @default(uuid())
  matchId        String
  slotNumber     Int
  teamId         String?
  lobbyStatus    LobbyStatus @default(EMPTY)
  playersInLobby Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  match          Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team           Team?       @relation(fields: [teamId], references: [id])

  @@unique([matchId, slotNumber])
  @@unique([matchId, teamId])
  @@index([matchId])
  @@index([teamId])
  @@index([deletedAt])
}

model MatchTeam {
  id               String          @id @default(uuid())
  matchId          String
  tournamentTeamId String?
  teamId           String
  slot             Int?
  status           MatchTeamStatus @default(ACTIVE)
  pointsOverride   Int?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  match            Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tournamentTeam   TournamentTeam? @relation(fields: [tournamentTeamId], references: [id], onDelete: SetNull)
  team             Team            @relation(fields: [teamId], references: [id])

  @@unique([matchId, tournamentTeamId])
  @@unique([matchId, teamId])
  @@unique([matchId, slot])
  @@index([deletedAt])
  @@index([matchId])
  @@index([teamId])
  @@index([tournamentTeamId])
}

model MatchTelemetry {
  id               String    @id @default(uuid())
  matchId          String    @unique
  payload          Json
  zoneCenter       Json?
  zoneRadius       Float?
  zonePhaseIndex   Int?
  zoneNextShrinkAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model TelemetryEventLog {
  id          String    @id @default(uuid())
  matchId     String
  source      String
  sequence    Int
  eventType   String
  payloadJson Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, source, sequence])
  @@index([matchId, receivedAt])
  @@index([matchId, processedAt])
}

model MatchStateSnapshot {
  id        String   @id @default(uuid())
  matchId   String   @unique
  stateJson Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model MediaAsset {
  id             String         @id @default(uuid())
  tournamentId   String?
  organizationId String?
  type           MediaAssetType
  url            String
  ownerType      String?
  ownerId        String?
  teamId         String?
  playerId       String?
  hash           String?
  externalKey    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  tournament     Tournament?    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  team           Team?          @relation("TeamMediaAssets", fields: [teamId], references: [id])
  player         Player?        @relation("PlayerMediaAssets", fields: [playerId], references: [id])

  @@index([deletedAt])
  @@index([ownerType, ownerId])
  @@index([tournamentId])
  @@index([organizationId])
  @@index([teamId])
  @@index([playerId])
}

model Notification {
  id         String               @id @default(uuid())
  title      String
  body       String
  audience   NotificationAudience @default(ALL)
  sentBy     String?
  createdAt  DateTime             @default(now())
  sentByUser User?                @relation(fields: [sentBy], references: [id])

  @@index([createdAt])
}

model Organization {
  id                       String                       @id @default(uuid())
  name                     String                       @unique
  slug                     String                       @unique
  broadcastKey             String                       @unique @default(dbgenerated("encode(gen_random_bytes(32), 'hex')")) @db.Char(64)
  isActive                 Boolean                      @default(true)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  deletedAt                DateTime?
  deletedBy                String?
  ownerUserId              String?
  owner                    User?                        @relation("OrganizationOwner", fields: [ownerUserId], references: [id])
  kycNote                  String?
  kycReviewedAt            DateTime?
  kycReviewedBy            String?
  kycStatus                KycStatus                    @default(PENDING)
  status                   OrganizationStatus           @default(PENDING)
  adminLinks               AdminOrganizationLink[]
  auditLogs                AuditLog[]
  organizerFeatures        OrganizerFeature[]
  players                  Player[]
  tags                     Tag[]
  teams                    Team[]
  teamMembers              TeamMember[]
  tournamentRegistrations  TournamentRegistration[]
  tournamentInvites        TournamentInvite[]
  tournaments              Tournament[]
  sessions                 Session[]
  sessionRegistrations     SessionRegistration[]
  groups                   Group[]
  stages                   Stage[]
  matches                  Match[]
  matchControlStates       MatchControlState[]
  matchEvents              MatchEvent[]
  matchRounds              MatchRound[]
  matchSlotResults         MatchSlotResult[]
  matchSlotPlayerResults   MatchSlotPlayerResult[]
  matchTopFraggers         MatchTopFragger[]
  rulesets                 Ruleset[]
  users                    User[]
  wallet                   Wallet?
  mediaAssets              MediaAsset[]
  branding                 OrganizationBranding?
  discordConfig            OrganizationDiscordConfig?
  widgets                  Widget[]
  widgetPresets            WidgetPreset[]
  obsTemplates             OBSTemplate[]
  obsScenes                OBSScene[]
  widgetVersions           WidgetVersion[]
  features                 OrganizationFeature[]
  licenses                 License[]
  observerLauncherSessions ObserverLauncherSession[]
  widgetInstances          WidgetInstance[]
  widgetApprovalEnforced   Boolean                      @default(false)
  widgetApprovals          OrganizationWidgetApproval[]
  standings                MatchStanding[]
  roundPlayerResults       RoundPlayerResult[]

  @@index([deletedAt])
  @@index([kycStatus])
  @@index([status])
  @@index([ownerUserId])
}

model OrganizationApplication {
  id              String                        @id @default(uuid())
  name            String
  email           String
  passwordHash    String
  applicantName   String
  rejectionReason String?
  status          OrganizationApplicationStatus @default(PENDING)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model OrganizationBranding {
  id                    String       @id @default(uuid())
  organizationId        String       @unique
  authoringMode         String       @default("minimal")
  minimalConfig         Json?
  advancedConfig        Json?
  mode                  String       @default("solid") @map("themeMode")
  backgroundSolid       String?
  widgetBackground      String?      @default("#0B1220")
  gradientStart         String?
  gradientEnd           String?
  gradientDirection     String       @default("diagonal")
  primaryColor          String?      @default("#00E5FF")
  secondaryColor        String?      @default("#0093FF")
  liveColor             String?      @default("#22C55E")
  accent                String       @default("#F5A524")
  backgroundStart       String?      @default("#050B18")
  backgroundEnd         String?      @default("#0B1220")
  backgroundCss         String?      @default("linear-gradient(135deg,#050B18,#0B1220)")
  effectiveBackground   String?      @default("#0B1220")
  textPrimary           String?      @default("#ffffff")
  textMuted             String?      @default("#cdd5e1")
  border                String?      @default("rgba(255,255,255,0.12)")
  panel                 String?      @default("#0b1220")
  shadow                String?      @default("0 22px 64px rgba(0,0,0,0.45)")
  glowAccent            String?      @default("rgba(0,229,255,0.32)")
  badgeBg               String?      @default("#142032")
  badgeText             String?      @default("#ffffff")
  defaultTeamLogoUrl    String?
  defaultPlayerPhotoUrl String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id])
}

model OrganizationDiscordConfig {
  id                          String       @id @default(uuid())
  organizationId              String       @unique
  enabled                     Boolean      @default(false)
  guildId                     String?      @db.VarChar(32)
  guildName                   String?      @db.VarChar(120)
  hubCategoryId               String?      @db.VarChar(32)
  hubCategoryName             String?      @db.VarChar(120)
  registrationsChannelId      String?      @db.VarChar(32)
  registrationsChannelName    String?      @db.VarChar(120)
  slotsChannelId              String?      @db.VarChar(32)
  slotsChannelName            String?      @db.VarChar(120)
  resultsChannelId            String?      @db.VarChar(32)
  resultsChannelName          String?      @db.VarChar(120)
  standingsChannelId          String?      @db.VarChar(32)
  standingsChannelName        String?      @db.VarChar(120)
  supportChannelId            String?      @db.VarChar(32)
  supportChannelName          String?      @db.VarChar(120)
  organizerRoleId             String?      @db.VarChar(32)
  organizerRoleName           String?      @db.VarChar(120)
  captainRoleId               String?      @db.VarChar(32)
  captainRoleName             String?      @db.VarChar(120)
  participantRoleId           String?      @db.VarChar(32)
  participantRoleName         String?      @db.VarChar(120)
  autoCreateSessionCategories Boolean      @default(false)
  autoCreateSessionChannels   Boolean      @default(false)
  autoSyncRoles               Boolean      @default(false)
  sessionCategoryPrefix       String?      @db.VarChar(40)
  sessionChannelPrefix        String?      @db.VarChar(40)
  notes                       String?
  lastValidatedAt             DateTime?
  updatedById                 String?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  organization                Organization @relation(fields: [organizationId], references: [id])
  updatedBy                   User?        @relation("OrganizationDiscordConfigUpdatedBy", fields: [updatedById], references: [id])

  @@index([updatedById])
  @@index([lastValidatedAt])
}

model OrganizerFeature {
  id             String       @id @default(uuid())
  organizationId String
  key            FeatureKey
  enabled        Boolean      @default(false)
  updatedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  updatedByUser  User?        @relation(fields: [updatedBy], references: [id])

  @@unique([organizationId, key])
  @@index([organizationId])
}

model OrganizationFeature {
  id             String       @id @default(uuid())
  organizationId String
  featureKey     String
  isEnabled      Boolean      @default(false)
  config         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, featureKey])
  @@index([organizationId])
}

model License {
  id               String                    @id @default(uuid())
  organizationId   String
  licenseKey       String                    @unique
  type             LicenseType
  status           LicenseStatus
  maxObservers     Int                       @default(1)
  expiresAt        DateTime
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  organization     Organization              @relation(fields: [organizationId], references: [id])
  launcherSessions ObserverLauncherSession[]

  @@index([organizationId])
  @@index([status])
  @@index([expiresAt])
}

model ObserverLauncherSession {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  machineId      String
  licenseId      String?
  startedAt      DateTime     @default(now())
  lastSeenAt     DateTime     @updatedAt
  endedAt        DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  license        License?     @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@unique([organizationId, machineId])
  @@index([organizationId, endedAt])
  @@index([userId])
  @@index([licenseId])
}

model Payout {
  id             String       @id @default(uuid())
  tournamentId   String
  teamId         String?
  playerId       String?
  walletId       String?
  amount         Decimal      @db.Decimal(14, 2)
  status         PayoutStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  approvedByUser User?        @relation("Payout_approvedBy", fields: [approvedBy], references: [id])
  player         Player?      @relation(fields: [playerId], references: [id])
  team           Team?        @relation(fields: [teamId], references: [id])
  tournament     Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  wallet         Wallet?      @relation(fields: [walletId], references: [id])

  @@index([playerId])
  @@index([status])
  @@index([teamId])
  @@index([tournamentId])
}

model PcobAppliedEvent {
  id        String   @id @default(uuid())
  matchId   String
  eventHash String   @unique
  eventType String
  appliedAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([eventHash])
  @@index([matchId])
}

model PcobUnmatchedKill {
  id            String   @id @default(uuid())
  matchId       String
  sessionId     String
  pubgAccountId String?
  ign           String?
  rawPayload    Json
  receivedAt    DateTime @default(now())
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([sessionId])
}

model PcobUnmatchedPlayer {
  id               String   @id @default(uuid())
  matchId          String
  pcobMatchId      String?
  slot             Int
  pubgPlayerId     String?
  ign              String
  teamTag          String?
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  resolved         Boolean  @default(false)
  resolvedPlayerId String?
  rawPayload       Json
  match            Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, slot, ign])
  @@index([matchId])
  @@index([resolved])
}

model MatchRound {
  id             String      @id @default(uuid())
  matchId        String
  organizationId String
  roundIndex     Int
  mapName        String?
  status         RoundStatus @default(PENDING)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  match         Match               @relation(fields: [matchId], references: [id], onDelete: Cascade)
  organization  Organization        @relation(fields: [organizationId], references: [id])
  teamResults   TeamRoundResult[]
  killEvents    KillEvent[]
  approval      ResultApproval?
  playerResults RoundPlayerResult[]

  @@unique([matchId, roundIndex])
  @@index([matchId])
  @@index([organizationId])
  @@index([status])
}

model TeamRoundResult {
  id               String   @id @default(uuid())
  matchRoundId     String
  teamId           String
  placementAuto    Int?
  killsAuto        Int?
  pointsAuto       Int?
  placementManual  Int?
  killsManual      Int?
  pointsManual     Int?
  penaltyPoints    Int?     @default(0)
  isManualOverride Boolean  @default(false)
  finalPlacement   Int?
  finalKills       Int?
  finalPoints      Int?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  matchRound MatchRound @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id])

  @@unique([matchRoundId, teamId])
  @@index([teamId])
}

model MatchStanding {
  id              String   @id @default(uuid())
  matchId         String
  organizationId  String
  tournamentId    String
  teamId          String
  rank            Int?
  totalKills      Int      @default(0)
  placementPoints Int      @default(0)
  bonusPoints     Int      @default(0)
  penaltyPoints   Int      @default(0)
  totalPoints     Int      @default(0)
  isLocked        Boolean  @default(false)
  isFinal         Boolean  @default(false)
  computedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  match        Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team         Team         @relation(fields: [teamId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  tournament   Tournament   @relation(fields: [tournamentId], references: [id])

  @@unique([matchId, teamId])
  @@index([matchId])
  @@index([tournamentId])
  @@index([organizationId])
}

model RoundPlayerResult {
  id             String   @id @default(uuid())
  matchRoundId   String
  organizationId String
  teamId         String?
  playerId       String?
  playerName     String
  kills          Int      @default(0)
  knocks         Int      @default(0)
  alive          Boolean? @default(true)
  source         String   @default("MANUAL")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matchRound   MatchRound   @relation(fields: [matchRoundId], references: [id], onDelete: Cascade)
  player       Player?      @relation(fields: [playerId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id])

