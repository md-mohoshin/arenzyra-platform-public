model YoutubeChannel {
  id               String                   @id @default(uuid())
  organizationId   String
  youtubeChannelId String
  title            String
  handle           String?
  thumbnailUrl     String?
  scopes           String[]                 @default([])
  accessTokenEnc   String?
  refreshTokenEnc  String?
  tokenExpiresAt   DateTime?
  status           YoutubeChannelStatus     @default(CONNECTED)
  connectedById    String?
  connectedAt      DateTime                 @default(now())
  lastSyncAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy      User?                    @relation("YoutubeChannelConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  comments         YoutubeComment[]
  replies          YoutubeCommentReply[]
  automationRules  YoutubeAutomationRule[]
  giveaways        YoutubeGiveaway[]
  liveSessions     YoutubeLiveChatSession[]
  liveMessages     YoutubeLiveChatMessage[]
  liveChatViewers  YoutubeLiveChatViewer[]
  viewerProfiles   YoutubeViewerProfile[]
  polls            YoutubePoll[]
  challenges       YoutubeChallenge[]
  snapshots        YoutubeChannelSnapshot[]
  chatCommands     YoutubeChatCommand[]
  chatTimers       YoutubeChatTimer[]
  chatLogs         YoutubeChatLog[]
  auditLogs        YoutubeAuditLog[]

  @@unique([organizationId, youtubeChannelId])
  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
}

model YoutubeChannelSnapshot {
  id                      String         @id @default(uuid())
  organizationId          String
  channelId               String
