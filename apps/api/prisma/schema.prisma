  createdBy      User                   @relation("TournamentInviteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  group          Group?                 @relation(fields: [groupId], references: [id], onDelete: SetNull)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage          Stage                  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  team           Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tournament     Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([contactEmail])
  @@index([createdById])
  @@index([groupId])
  @@index([organizationId, status])
  @@index([stageId])
  @@index([teamId])
  @@index([tournamentId, createdAt])
  @@index([tournamentId, status])
}

model TournamentSponsor {
  id                      String      @id @default(uuid())
  tournamentId            String
  name                    String
  logoUrl                 String
  tier                    SponsorTier
  displayOrder            Int         @default(0)
  isActive                Boolean     @default(true)
  rotationIntervalSeconds Int?
  websiteUrl              String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  deletedAt               DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([tier])
  @@index([deletedAt])
  @@map("Sponsor")
}

enum SponsorTier {
  TITLE
  GOLD
  SILVER
  BRONZE
  MEDIA
}

model User {
  id                              String                       @id @default(uuid())
  email                           String                       @unique
  password                        String
  name                            String
  role                            Role
  organizationId                  String?
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt
  deletedAt                       DateTime?
  deletedBy                       String?
  bannedUntil                     DateTime?
  status                          UserStatus                   @default(ACTIVE)
  adminLinks                      AdminOrganizationLink[]
  auditLogs                       AuditLog[]
  bansCreated                     Ban[]                        @relation("Ban_createdByToUser")
  bans                            Ban[]                        @relation("Ban_targetUserIdToUser")
  notifications                   Notification[]
  organizerFeatures               OrganizerFeature[]
  payoutsApproved                 Payout[]                     @relation("Payout_approvedBy")
  playerDisciplines               PlayerDiscipline[]
  reportsFiled                    Report[]                     @relation("Report_reporter")
  reportsResolved                 Report[]                     @relation("Report_resolver")
  reviewedTournamentRegistrations TournamentRegistration[]     @relation("TournamentRegistrationReviewedBy")
  createdTournamentInvites        TournamentInvite[]           @relation("TournamentInviteCreatedBy")
  systemFlags                     SystemFlag[]
  tags                            Tag[]
  killEventsCreated               KillEvent[]                  @relation("KillEventCreatedBy")
  resultApprovals                 ResultApproval[]             @relation("ResultApprovalApprovedBy")
  adminAdjustmentsCreated         AdminAdjustment[]            @relation("AdminAdjustmentCreatedBy")
  matchControlStateUpdates        MatchControlState[]          @relation("MatchControlStateUpdatedBy")
  organization                    Organization?                @relation(fields: [organizationId], references: [id])
  wallet                          Wallet?
  walletTransactions              WalletTransaction[]
  ownedOrganizations              Organization[]               @relation("OrganizationOwner")
  observerLauncherSessions        ObserverLauncherSession[]
  refreshTokens                   RefreshToken[]
  widgetApprovalsGranted          OrganizationWidgetApproval[] @relation("WidgetApprovalApprovedBy")
  createdSessions                 Session[]                    @relation("SessionCreatedBy")
  updatedSessions                 Session[]                    @relation("SessionUpdatedBy")
  sessionRegistrations            SessionRegistration[]        @relation("SessionRegistrationRegisteredBy")
  updatedDiscordConfigs           OrganizationDiscordConfig[]  @relation("OrganizationDiscordConfigUpdatedBy")

  @@index([deletedAt])
  @@index([organizationId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  persistent Boolean   @default(false)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model Wallet {
  id                 String              @id @default(uuid())
  userId             String?             @unique
  organizationId     String?             @unique
  balance            Decimal             @default(0) @db.Decimal(14, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  payouts            Payout[]
  organization       Organization?       @relation(fields: [organizationId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])
  walletTransactions WalletTransaction[]

  @@index([organizationId])
  @@index([userId])
}

model WalletTransaction {
  id            String                @id @default(uuid())
  walletId      String
  type          WalletTransactionType
  amount        Decimal               @db.Decimal(14, 2)
  reason        String?
  createdBy     String?
  createdAt     DateTime              @default(now())
  createdByUser User?                 @relation(fields: [createdBy], references: [id])
  wallet        Wallet                @relation(fields: [walletId], references: [id])

  @@index([createdAt])
  @@index([walletId])
}

model Game {
  id        String    @id @default(uuid())
  key       GameKey   @unique
  name      String
  isEnabled Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  matches   Match[]
  sessions  Session[]
  teams     Team[]
}

model TeamAlias {
  id        String   @id @default(uuid())
  teamId    String
  name      String
  tag       String?
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id])

  @@unique([teamId, name])
  @@index([teamId])
}

model Ruleset {
  id          String        @id @default(uuid())
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id])
  gameKey     GameKey
  name        String
  description String?
  config      Json
  isDefault   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  matches     Match[]
  matchScores MatchScore[]
  sessions    Session[]
  tournaments Tournament[]  @relation("TournamentRulesetRef")

  @@index([orgId])
  @@index([gameKey])
}

model MatchScore {
  id         String   @id @default(uuid())
  matchId    String   @unique
  rulesetId  String?
  computedAt DateTime @default(now())
  data       Json
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  ruleset    Ruleset? @relation(fields: [rulesetId], references: [id])
}

model Widget {
  id             String         @id @default(uuid())
  organizationId String
  key            String
  name           String
  description    String?
  category       String         @default("utility")
  kind           WidgetKind
  config         Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id])
  presets        WidgetPreset[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([category])
  @@index([deletedAt])
}

model WidgetPreset {
  id             String       @id @default(uuid())
  widgetId       String?
  widgetKey      String
  organizationId String
  name           String
  description    String?
  config         Json?
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  widget         Widget?      @relation(fields: [widgetId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, widgetKey, name])
  @@index([organizationId, widgetKey])
  @@index([organizationId])
  @@index([widgetId])
  @@index([deletedAt])
}

model WidgetVersion {
  id             String              @id @default(uuid())
  organizationId String
  widgetKey      String
  version        String
  status         WidgetVersionStatus @default(DRAFT)
  configSchema   Json?
  createdAt      DateTime            @default(now())
  publishedAt    DateTime?
  organization   Organization        @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, widgetKey, version])
  @@index([organizationId, widgetKey, status])
}

model WidgetInstance {
  id  String @id @default(uuid())
  key String @unique @default(uuid())

  widgetKey      String
  organizationId String
  tournamentId   String?
  matchId        String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tournament   Tournament?  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match        Match?       @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([organizationId, widgetKey])
  @@index([organizationId])
  @@index([tournamentId])
  @@index([matchId])
  @@index([widgetKey])
}

model OrganizationWidgetApproval {
  id             String       @id @default(uuid())
  organizationId String
  widgetKey      String
  isApproved     Boolean      @default(false)
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approvedByUser User?        @relation("WidgetApprovalApprovedBy", fields: [approvedBy], references: [id])

  @@unique([organizationId, widgetKey])
  @@index([organizationId])
  @@index([widgetKey])
  @@index([isApproved])
}

enum WidgetVersionStatus {
  DRAFT
  STABLE
  DEPRECATED
}

model OBSTemplate {
  id             String          @id @default(uuid())
  organizationId String
  key            String
  name           String
  description    String?
  kind           ObsTemplateKind
  config         Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?
  organization   Organization    @relation(fields: [organizationId], references: [id])
  scenes         OBSScene[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@index([deletedAt])
}

model OBSScene {
  id             String       @id @default(uuid())
  templateId     String
  organizationId String
  name           String
  layout         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  template       OBSTemplate  @relation(fields: [templateId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([templateId])
  @@index([organizationId])
  @@index([deletedAt])
}

