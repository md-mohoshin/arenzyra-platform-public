{
  "name": "arenzyra-observer-launcher",
  "version": "0.1.32",
  "private": true,
  "type": "module",
  "description": "Arenzyra Observer Launcher for ShadowTracker operations",
  "author": "Arenzyra",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --port 5400 --strictPort",
    "sync:branding": "node ../../scripts/sync-brand-icons.cjs",
    "sync:maps:development": "node ../../scripts/sync-desktop-maps.cjs --development-only",
    "dev:electron": "npm run sync:maps:development && wait-on http://localhost:5400 && cross-env ELECTRON_RUN_AS_NODE=0 DEV_SERVER_PORT=5400 electron .",
    "lint": "eslint .",
    "build": "vite build",
    "verify:release-inputs": "node ../../scripts/verify-desktop-release-inputs.cjs",
    "verify:connector-provenance": "node ../../scripts/verify-desktop-connector-provenance.cjs",
    "verify:map-provenance": "node ../../scripts/verify-desktop-map-provenance.cjs",
    "build:electro": "npm run build:electron",
    "build:electron": "npm run verify:release-inputs && npm run sync:branding && npm run verify:release-inputs && npm run build && npm run verify:release-inputs && npm run verify:map-provenance && electron-builder --config electron-builder.config.cjs",
    "build:electron:candidate": "npm run verify:release-inputs && npm run sync:branding && npm run verify:release-inputs && npm run build && npm run verify:release-inputs && electron-builder --config electron-builder.candidate.config.cjs --publish never",
    "run:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Start-Process '.\\dist\\win-unpacked\\Arenzyra Observer Launcher.exe'\"",
    "build:electron:run": "npm run build:electron && npm run run:packaged",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@img/sharp-win32-x64": "0.35.3",
    "axios": "^1.18.0",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "loose-envify": "1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "scheduler": "0.23.2",
    "sharp": "^0.35.3",
    "socket.io-client": "^4.8.3",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "7zip-bin": "5.2.0",
    "electron": "41.2.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vite-plugin-electron": "^0.11.2",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "engine.io-client": "6.6.6",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.1",
    "qs": "6.15.3",
    "socket.io-parser": "4.2.7"
  }
}
