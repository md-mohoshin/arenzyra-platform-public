{
  "name": "arenzyra-observer-launcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arenzyra Observer Launcher for ShadowTracker operations",
  "author": "Arenzyra",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --port 5400 --strictPort",
    "sync:branding": "node ../../scripts/sync-brand-icons.cjs",
    "sync:maps": "node ../../scripts/sync-desktop-maps.cjs",
    "dev:electron": "npm run sync:maps && wait-on http://localhost:5400 && cross-env ELECTRON_RUN_AS_NODE=0 DEV_SERVER_PORT=5400 electron .",
    "lint": "eslint .",
    "build": "vite build",
    "build:electro": "npm run build:electron",
    "build:electron": "npm run sync:branding && npm run build && npm run sync:maps && electron-builder",
    "run:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Start-Process '.\\dist\\win-unpacked\\Arenzyra Observer Launcher.exe'\"",
    "build:electron:run": "npm run build:electron && npm run run:packaged",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.arenzyra.observerlauncher",
    "productName": "Arenzyra Observer Launcher",
    "asar": false,
    "asarUnpack": [
      "**/*.node",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "protocols": [
      {
        "name": "Arenzyra Observer Launcher",
        "schemes": [
          "arenzyra-launcher"
        ]
      }
    ],
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../ob.js",
        "to": "connectors/ob.js"
      },
      {
        "from": "electron/direct-observer-transport-payload.cjs",
        "to": "connectors/direct-observer-transport-payload.cjs"
      },
      {
        "from": "electron/observer-telemetry-contract.cjs",
        "to": "connectors/observer-telemetry-contract.cjs"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/default-team.png",
        "to": "default-team.png"
      },
      {
        "from": "build/default-player.png",
        "to": "default-player.png"
      },
      {
        "from": "build/shadow-logo-template.svg",
        "to": "shadow-logo-template.svg"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "dependencies": {
    "@img/sharp-win32-x64": "0.34.5",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "socket.io-client": "^4.8.3",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vite-plugin-electron": "^0.11.2",
    "wait-on": "^7.2.0"
  }
}
